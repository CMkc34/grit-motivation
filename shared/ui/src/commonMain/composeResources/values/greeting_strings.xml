<?xml version="1.0" encoding="utf-8"?>
<!-- Daily greeting by the plant on the first app start of a day (fork). The plant speaks as "I". -->
<resources>
    <string name="greeting_header_welcome">Welcome</string>
    <string name="greeting_header_morning">Good morning</string>
    <string name="greeting_header_day">Hello</string>
    <string name="greeting_header_evening">Good evening</string>
    <!-- %1$s = plant name -->
    <string name="greeting_welcome_title">Hi, I am %1$s!</string>
    <string name="greeting_welcome_text">Every routine you check off gives me water. That way I grow with you into a big tree.</string>
    <string name="greeting_first_day_title">Great to have you here!</string>
    <string name="greeting_first_day_text">Check off your first routine today and I get my first water.</string>
    <string name="greeting_tired_title">I am a little tired</string>
    <string name="greeting_tired_text">Check off a routine today and I will wake up again.</string>
    <plurals name="greeting_growing_title">
        <item quantity="one">%1$d day in a row!</item>
        <item quantity="other">%1$d days in a row!</item>
    </plurals>
    <!-- %1$d = active days still missing, %2$d = number of the next stage -->
    <plurals name="greeting_growing_next">
        <item quantity="one">%1$d more active day and I grow to stage %2$d.</item>
        <item quantity="other">%1$d more active days and I grow to stage %2$d.</item>
    </plurals>
    <string name="greeting_growing_last">I am a mighty tree. Thanks for sticking with it!</string>
    <!-- 💧 is drawn as the water coin -->
    <string name="greeting_water">You have %1$d 💧</string>
    <string name="greeting_start">Let’s go</string>
    <string name="greeting_setting">Daily greeting</string>
    <string name="greeting_setting_desc">Your plant greets you on the first app start of each day</string>
    <!-- empty routine page -->
    <string name="greeting_empty_title">%1$s is waiting for you</string>
    <string name="greeting_empty_text">Add a routine and %1$s wakes up.</string>
    <string name="greeting_empty_button">Add routine</string>
</resources>
