    <string name="avatar_default_name">Grit</string>
    <string name="avatar_stage_label">Stage %1$d of 12 · %2$s</string>
    <plurals name="avatar_days_to_next">
        <item quantity="one">%1$d more active day to the next stage</item>
        <item quantity="other">%1$d more active days to the next stage</item>
